# Receipt agent (agent/README.md). Copy to agent/.env and fill in; never commit the copy.
# All values below are placeholders.

# --- receipts mailbox (IMAP over TLS, password or app password; OAuth-only mailboxes do not work)
ZF_AGENT_IMAP_HOST=imap.example.com
ZF_AGENT_IMAP_PORT=993
ZF_AGENT_IMAP_USER=receipts@example.com
ZF_AGENT_IMAP_PASSWORD=
ZF_AGENT_IMAP_FOLDER=INBOX

# Addresses whose messages are read, separated by commas (compared case-insensitively).
ZF_AGENT_ALLOWED_SENDERS=you@example.com
# Required: this word must appear in the subject (a From header can be forged); the agent does not start without it.
ZF_AGENT_SUBJECT_SECRET=

# --- answer mail (leave SMTP_HOST empty to send no answers; login defaults to the IMAP login)
ZF_AGENT_SMTP_HOST=smtp.example.com
# ssl (port 465) or starttls (port 587)
ZF_AGENT_SMTP_SECURITY=ssl
ZF_AGENT_SMTP_PORT=465
ZF_AGENT_SMTP_USER=
ZF_AGENT_SMTP_PASSWORD=
ZF_AGENT_REPLY_FROM=receipts@example.com

# --- z-finance (the review threshold is set in the app: Receipts -> Settings)
# Leave it out or empty to follow the launcher (<data dir>/runtime/launcher.json), else 8765.
ZF_AGENT_API_URL=http://127.0.0.1:8765

# --- claude -p and cost limits
ZF_AGENT_CLAUDE_BIN=claude
# Empty = Claude Code's default model; e.g. sonnet or haiku costs less.
ZF_AGENT_CLAUDE_MODEL=
ZF_AGENT_CLAUDE_TIMEOUT=180
ZF_AGENT_CLAUDE_MAX_BUDGET_USD=0.50
# Photos read per run (1-50).
ZF_AGENT_MAX_RECEIPTS=10

# Optional: also append the JSON-lines log to this file.
ZF_AGENT_LOG_FILE=
